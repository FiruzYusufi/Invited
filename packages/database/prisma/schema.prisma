generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  password    String
  name        String?
  role        String       @default("CLIENT") // ADMIN, MANAGER, CLIENT, USER
  managedBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invitations Invitation[]
  purchases   Purchase[]
}

model Package {
  id          String     @id @default(cuid())
  name        String
  description String?
  price       Float
  inviteLimit Int
  features    String?    // JSON string
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id           String       @id @default(cuid())
  userId       String
  packageId    String
  status       String       @default("PENDING") // PENDING, COMPLETED, CANCELLED
  invitesUsed  Int          @default(0)
  invitesLimit Int
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id])
  package      Package      @relation(fields: [packageId], references: [id])
  invitations  Invitation[]
}

model Invitation {
  id          String   @id @default(cuid())
  userId      String
  purchaseId  String
  clientToken String   @unique @default(uuid())
  title       String
  groomName   String
  brideName   String
  eventDate   DateTime
  location    String
  description String?
  theme       String   @default("champagne")
  viewCount   Int      @default(0)
  rsvpCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  purchase    Purchase @relation(fields: [purchaseId], references: [id])
  rsvps       Rsvp[]
  guests      Guest[]
}

model Guest {
  id           String     @id @default(cuid())
  invitationId String
  name         String
  phone        String?
  email        String?
  smsSent      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invitation   Invitation @relation(fields: [invitationId], references: [id])
}

model Rsvp {
  id           String     @id @default(cuid())
  invitationId String
  name         String
  status       String     // ATTENDING, NOT_ATTENDING
  guests       Int        @default(1)
  message      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  invitation   Invitation @relation(fields: [invitationId], references: [id])
}
