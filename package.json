{
  "name": "invited",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev:client": "turbo run dev --filter=client",
    "dev:manager": "turbo run dev --filter=manager",
    "dev:admin": "turbo run dev --filter=admin",
    "db:generate": "turbo run db:generate --filter=@invited/database",
    "db:migrate": "cd packages/database && pnpm prisma migrate dev",
    "db:seed": "cd packages/database && node prisma/seed.mjs",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  }
}
